# ============================================================
# Nadics LectureHub — Smart Lecture Management System (SLMS)
# Environment Configuration Template
# ============================================================
# Copy this file to .env and update the values for your environment.
# NEVER commit the .env file to version control.
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
APP_NAME="Nadics LectureHub"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Nadics%20LectureHub/public
APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_VERSION=1.0.0
APP_KEY=

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nadics_lecturehub
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

# ------------------------------------------------------------
# SESSION
# ------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAME_SITE=Lax

# ------------------------------------------------------------
# MAIL / SMTP
# ------------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@nadicslecturehub.com
MAIL_FROM_NAME="Nadics LectureHub"

# ------------------------------------------------------------
# SMS GATEWAY
# ------------------------------------------------------------
SMS_DRIVER=
SMS_API_KEY=
SMS_SENDER_ID=SLMS

# ------------------------------------------------------------
# STORAGE
# ------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_MAX_UPLOAD=104857600
UPLOAD_PATH=uploads

# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------
CSRF_TOKEN_LIFETIME=3600
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60
PASSWORD_MIN_LENGTH=8
BCRYPT_COST=12

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
LOG_LEVEL=debug
LOG_CHANNEL=daily

# ------------------------------------------------------------
# CACHE
# ------------------------------------------------------------
CACHE_DRIVER=file
CACHE_TTL=3600

# ------------------------------------------------------------
# API
# ------------------------------------------------------------
API_VERSION=v1
API_RATE_LIMIT=120
API_TOKEN_LIFETIME=86400

# ------------------------------------------------------------
# THIRD-PARTY SERVICES
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
