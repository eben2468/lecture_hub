{
    "name": "nadics/lecturehub",
    "description": "Smart Lecture Management System (SLMS) — Enterprise-grade digital learning platform for African universities",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Nadics Solutions",
            "email": "info@nadicssolutions.com"
        }
    ],
    "keywords": [
        "lecture",
        "management",
        "university",
        "streaming",
        "education",
        "saas"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/",
            "Database\\": "database/"
        },
        "files": [
            "core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --colors=always"
    }
}
