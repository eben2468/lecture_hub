<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── Step 1: Serve real files and directories directly ─────────────────────
    # (CSS, JS, images, uploads are served without going through PHP)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ── Step 2: Route all other requests through the front controller ─────────
    # This handles all application routes (login, register, dashboard, etc.)
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ── Security: disable directory listing ──────────────────────────────────────
Options -Indexes

# ── Security: block access to sensitive files ─────────────────────────────────
<FilesMatch "(^\.env|composer\.(json|lock)|\.gitkeep)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
